{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"],
      "@/*": ["web/src/*"]
    }
  },
  "include": [
    "shared/**/*.ts",
    "signalling/**/*.ts",
    "web/src/**/*.ts",
    "web/src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "web/dist"
  ]
}
